@startuml
title Campus Food Ordering System — Domain Class Diagram DRAFT
hide methods
skinparam classAttributeIconSize 0

class StudentAccount {
  studentNumber
  nickname
}
class MerchantAccount
class AdministratorAccount
class Merchant {
  name
  active
  fixedDiscount
}
class Category {
  name
}
class Item {
  name
  basePrice
  image
  listed
  inventoryMode
  stockQuantity
  manuallySoldOut
}
class OptionGroup {
  minimumSelections
  maximumSelections
}
class CustomOption {
  name
  surcharge
}
class Cart
class CartLine {
  quantity
  note
}
class Order {
  orderId
  aggregateStatus
  total
}
class Suborder {
  suborderId
  status
  pickupTime
  discount
  total
}
class OrderLine {
  itemNameSnapshot
  basePriceSnapshot
  quantity
  note
}
class SelectedOption {
  optionNameSnapshot
  surchargeSnapshot
}

StudentAccount "1" -- "0..*" Order : places
MerchantAccount "1" -- "1" Merchant : operates
AdministratorAccount ..> Merchant : manages accounts
Merchant "1" -- "0..*" Category : owns
Merchant "1" -- "0..*" Item : owns
Category "0..1" -- "0..*" Item : classifies
Item "1" -- "0..*" OptionGroup
OptionGroup "1" -- "0..*" CustomOption
StudentAccount "0..1" -- "1" Cart : uses
Cart "1" -- "0..*" CartLine
CartLine "*" -- "1" Item
CartLine "*" -- "0..*" CustomOption : selects
Order "1" *-- "1..*" Suborder
Suborder "*" -- "1" Merchant
Suborder "1" *-- "1..*" OrderLine
OrderLine "*" -- "0..*" SelectedOption

note right of StudentAccount
  Requirements: FR-01, FR-24, FR-29
end note
note right of Merchant
  Requirements: FR-02, FR-03, FR-06, FR-09, FR-20
end note
note right of Item
  Requirements: FR-06–FR-12, FR-22, FR-27
end note
note right of Cart
  Requirements: FR-12–FR-15
end note
note right of Order
  Requirements: FR-16, FR-24–FR-25, FR-28–FR-30, FR-33
end note
note right of Suborder
  Requirements: FR-16–FR-21, FR-26–FR-30
end note
note right of OrderLine
  Requirements: FR-13, FR-19, FR-28
end note

@enduml
